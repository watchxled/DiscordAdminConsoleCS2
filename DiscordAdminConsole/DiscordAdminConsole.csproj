<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>DiscordAdminConsole</AssemblyName>
    <RootNamespace>DiscordAdminConsole</RootNamespace>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <Version>1.0.1</Version>
    <DebugType>none</DebugType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CounterStrikeSharp.API" Version="1.0.247" />
    <PackageReference Include="Discord.Net.Core" Version="3.15.0" />
    <PackageReference Include="Discord.Net.Rest" Version="3.15.0" />
    <PackageReference Include="Discord.Net.WebSocket" Version="3.15.0" />
    <PackageReference Include="MySqlConnector" Version="2.3.5" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <Target Name="StripRuntimeProvidedAssemblies" AfterTargets="Publish">
    <ItemGroup>
      <RuntimeProvided Include="$(PublishDir)*.dll" Exclude="$(PublishDir)DiscordAdminConsole.dll;$(PublishDir)Discord.Net.Core.dll;$(PublishDir)Discord.Net.Rest.dll;$(PublishDir)Discord.Net.WebSocket.dll;$(PublishDir)MySqlConnector.dll;$(PublishDir)Newtonsoft.Json.dll;" />
    </ItemGroup>
    <Delete Files="@(RuntimeProvided)" />
     </Target>

</Project>
